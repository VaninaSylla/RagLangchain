# LLM / Embeddings
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3-4b
EMBEDDING_MODEL=nomic-embed-text
RERANK_MODEL=BAAI/bge-reranker-base

# Vectorstore
CHROMA_PERSIST_DIR=data/chroma_db
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVE_K=20
FINAL_K=4

# Databases
SQLITE_DB_NAME=employees.db
POSTGRES_DSN=postgresql://postgres:Admin_Vanina@localhost:5432/purchases_db
MONGO_URI=mongodb://localhost:27017
MONGO_DB=services_db

# App
STREAMLIT_PORT=8501
LOG_LEVEL=INFO
APP_ENV=development
